<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qmini_hardware</name>
  <version>0.0.1</version>
  <description>RS-485 motor bus driver for Qmini. Vendors unitree_actuator_sdk; one executor per RS-485 channel; publishes JointState; subscribes to MotorCommand. Requires SafetyHeartbeat to enable torque.</description>
  <maintainer email="okay1984@gmail.com">Tony Wang</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>qmini_msgs</depend>
  <depend>rcutils</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
