<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qmini_controllers</name>
  <version>0.0.1</version>
  <description>Thin PD packer. The GO-M8010-6 closes its PD loop in firmware, so this package just loads kp/kd from gains.yaml and forwards (q_des, dq_des, tau_ff, kp, kd) to qmini_hardware.</description>
  <maintainer email="okay1984@gmail.com">Tony Wang</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>qmini_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
