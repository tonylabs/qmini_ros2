<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qmini_bringup</name>
  <version>0.0.1</version>
  <description>Launch composition. Verifies DS4 MAC is bonded before launching motion-enabling nodes. Provides view_robot.launch.py (M0), hardware.launch.py (M1+), and hardware_teleop.launch.py (M6+).</description>
  <maintainer email="okay1984@gmail.com">Tony Wang</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>qmini_description</exec_depend>
  <exec_depend>qmini_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
